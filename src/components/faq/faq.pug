mixin faq(title)
	.rs-faq
		.rs-faq__head
			.rs-faq__title=title
			.rs-faq__toggle
		.rs-faq__body-wrap
			.rs-faq__body
				.text 
					p Какой-то длинный скрытый текст Какой-то длинный скрытый текст Какой-то длинный скрытый текст Какой-то длинный скрытый текст Какой-то длинный скрытый текст
					ul 
						li список
						li список
						li список
						li список
.block(data-aos = "fade-up")
	.block__head 
		h2 часто задаваемые вопросы
		.block__decor(data-x="l" data-y="t" type="1")
		.block__decor(data-x="r" data-y="b" type="2")
	.block__body 
		.rs-faqs 
			+faq('Безопасен ли умный дом? ')
			+faq('Что значит “умный дом под ключ”?')
			+faq('Система умный дом экономит энергию?                      ')
			+faq('Сколько времени займет установка умного дома?')
			+faq('Можно ли управлять не только домом, но и участком?')
			+faq('Вы работаете только в Санкт-Петербурге и области?')
				