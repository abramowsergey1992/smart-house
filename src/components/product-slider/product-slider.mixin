mixin productSlider(title)
	.block(data-aos = "fade-up")
		.block__head 
			h2=title
			.block__decor(data-x="l" data-y="t" type="5")
			.block__decor(data-x="r" data-y="b" type="6")
		.block__body 
			.product-slider.swiper 
				.swiper-wrapper 
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
					+product().swiper-slide
				.product-slider__nav 
					.product-slider__prev
						+sprite('next')
					.product-slider__next
						+sprite('next')